# Upstash Redis (REST API) — copy to .env and fill in your database values.
# Create a free database at https://console.upstash.com/ → Redis → REST API.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional: Discord webhook that gets a message for every new bouquet.
DISCORD_BOUQUET_WEBHOOK_URL=""
