# Upstash Redis (REST API) — copy to .env and fill in your database values.
# Create a free database at https://console.upstash.com/ → Redis → REST API.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional: Discord webhook that gets a message for every new bouquet.
DISCORD_BOUQUET_WEBHOOK_URL=""

# Optional: Pinata JWT to enable voice notes. Create one at
# https://app.pinata.cloud/developers/api-keys (needs org:files:write).
PINATA_JWT=""
# Optional: your dedicated gateway host, e.g. fun-llama-300.mypinata.cloud
PINATA_GATEWAY=""

# Required for voice-note cleanup: QStash schedules one unpin per bouquet.
# Create a token at https://console.upstash.com/qstash (free: 1000 msgs/day,
# max delay 7 days).
QSTASH_TOKEN=""
# Shared secret QStash sends to /api/voice/expire. Any random 16+ char string.
VOICE_EXPIRY_SECRET=""
# Testing only: override the 7d QStash delay, e.g. 45s, to exercise cleanup fast.
# VOICE_EXPIRY_DELAY="45s"
